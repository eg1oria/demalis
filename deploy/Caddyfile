# https для сайта и бэкенда: Caddy сам получает и продлевает сертификаты Let's Encrypt.
# Домены — SITE_DOMAIN и API_DOMAIN в backend/.env (например demalys.kz и api.demalys.kz).
# Входящий X-Forwarded-For от посетителя Caddy не пропускает, а ставит настоящий IP —
# по нему сайт и бэкенд считают лимит заявок.

(security) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

{$SITE_DOMAIN:localhost} {
	import security
	reverse_proxy frontend:3000
}

www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}

{$API_DOMAIN:api.localhost} {
	import security
	reverse_proxy backend:4000
}
