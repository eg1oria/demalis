# Шаблон переменных окружения.
# Скопируй в .env.local (он не попадает в git) и заполни значения.
# Как получить ключи — см. docs/SETUP.md.

# ── Этап 0 ────────────────────────────────────────────────
# Название сайта (везде в интерфейсе берётся отсюда).
NEXT_PUBLIC_SITE_NAME=Демалыс

# ── Этап 12: бэкенд (NestJS, папка backend/) ─────────────
# Адрес бэкенда для запросов с сервера Next.js (локально — http://127.0.0.1:4000).
API_URL=http://127.0.0.1:4000
# Адрес бэкенда, видимый из браузера: туда админка загружает фото.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Общий секрет с бэкендом (INTERNAL_API_SECRET в backend/.env): с ним бэкенд
# верит переданному IP посетителя для лимита заявок. Не с префиксом NEXT_PUBLIC_.
INTERNAL_API_SECRET=
# Email админов через запятую — те же, что ADMIN_EMAILS в backend/.env.
ADMIN_EMAILS=

# ── Этап 6: SEO и аналитика ───────────────────────────────
# Адрес сайта (ссылки, sitemap, canonical).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Номер счётчика Яндекс Метрики (docs/SEO.md). Пусто — счётчика нет.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Подтверждение прав в Яндекс Вебмастере и Google Search Console (значение content мета-тега).
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# ── Этап 11: Google Ads и Google Analytics (docs/SEO.md, раздел 6) ───
# Пусто — тег Google не подключается. Теги учитывают выбор в баннере cookie (Consent Mode v2).
# Google Analytics 4: идентификатор потока, вида G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=
# Google Ads: идентификатор тега, вида AW-123456789.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Метки конверсий Google Ads (часть после «/» в send_to: AW-123456789/AbCdEf).
NEXT_PUBLIC_ADS_CONV_LEAD=
NEXT_PUBLIC_ADS_CONV_WHATSAPP=
NEXT_PUBLIC_ADS_CONV_CALL=
