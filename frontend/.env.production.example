# Шаблон frontend/.env для сервера (docker-compose.prod.yml, deploy/deploy.sh).
# Скопируй: cp frontend/.env.production.example frontend/.env — и заполни.
# Для своего компьютера — другой шаблон: .env.example → .env.local.
# NEXT_PUBLIC_* вшиваются в сайт при сборке: после их правки — ./deploy/deploy.sh --no-pull.

NEXT_PUBLIC_SITE_NAME=Демалыс
# Адрес сайта (ссылки, sitemap, canonical) — https://<SITE_DOMAIN из backend/.env>.
NEXT_PUBLIC_SITE_URL=https://demalys.kz

# Бэкенд внутри Docker — не менять.
API_URL=http://backend:4000
# Бэкенд для браузера (загрузка фото из админки) — https://<API_DOMAIN>.
NEXT_PUBLIC_API_URL=https://api.demalys.kz
# Тот же, что INTERNAL_API_SECRET в backend/.env.
INTERNAL_API_SECRET=
# Те же, что ADMIN_EMAILS в backend/.env.
ADMIN_EMAILS=

# SEO и аналитика (docs/SEO.md). Пусто — не подключаются.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADS_CONV_LEAD=
NEXT_PUBLIC_ADS_CONV_WHATSAPP=
NEXT_PUBLIC_ADS_CONV_CALL=
