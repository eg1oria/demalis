# Шаблон переменных окружения.
# Скопируй в .env.local (он не попадает в git) и заполни значения.
# Как получить ключи — см. docs/SETUP.md.

# ── Этап 0 ────────────────────────────────────────────────
# Название сайта (везде в интерфейсе берётся отсюда).
NEXT_PUBLIC_SITE_NAME=Демалыс

# ── Этап 1: Supabase ──────────────────────────────────────
# Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ: только на сервере, никогда не с префиксом NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Email админов через запятую.
ADMIN_EMAILS=

# ── Этапы 4–5: Telegram ───────────────────────────────────
# Как получить — docs/SETUP.md, раздел 2а. Без них заявки сохраняются,
# но уведомление админу в Telegram не уходит.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_CHAT_ID=

# ── Этап 6: SEO и аналитика ───────────────────────────────
# Адрес сайта. С Этапа 4 — ещё и для ссылки на заявки в сообщении Telegram.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YANDEX_METRIKA_ID=
