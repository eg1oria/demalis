# Шаблон переменных окружения бэкенда.
# Скопируй в .env (он не попадает в git) и заполни значения.
# Как получить ключи — см. frontend/docs/SETUP.md.

# ── База ──────────────────────────────────────────────────
# Локально — Postgres из docker-compose.yml (docker compose up -d в корне).
DATABASE_URL=postgresql://demalis:demalis@127.0.0.1:5440/demalis
# На сервере (docker-compose.prod.yml) — пароль базы (openssl rand -hex 24),
# один и тот же в обеих строках:
# POSTGRES_PASSWORD=<пароль>
# DATABASE_URL=postgresql://demalis:<пароль>@postgres:5432/demalis
PORT=4000

# ── Сайт ──────────────────────────────────────────────────
# Адрес фронтенда: ссылки в письмах и Telegram, CORS для загрузки фото.
SITE_URL=http://localhost:3000
SITE_NAME=Демалыс
# Публичный https-адрес самого бэкенда (https://api.<домен>) — для webhook Telegram.
PUBLIC_API_URL=
# Только на сервере: домены для https (Caddy из docker-compose.prod.yml сам получит
# сертификаты). Сайт — SITE_DOMAIN (и www.SITE_DOMAIN), бэкенд — API_DOMAIN.
# SITE_DOMAIN=demalys.kz
# API_DOMAIN=api.demalys.kz
# За nginx или другим прокси: TRUST_PROXY=1 (тогда IP посетителя — из X-Forwarded-For).
# docker-compose.prod.yml включает его сам.
# TRUST_PROXY=1

# ── Вход в админку ────────────────────────────────────────
# Email админов через запятую.
ADMIN_EMAILS=
# Секрет подписи сессий и ссылок для загрузки фото: длинная случайная строка.
JWT_SECRET=
# Почта для писем со ссылкой входа. Локально — Mailpit из docker-compose.yml
# (письма видны на http://127.0.0.1:8025). В работе — SMTP Resend, Brevo и т. п.:
# smtps://логин:пароль@smtp.example.com:465
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Демалыс <no-reply@localhost>

# ── Формы с сайта ─────────────────────────────────────────
# Секрет для хэша IP в лимите заявок: длинная случайная строка.
RATE_LIMIT_SECRET=
# Общий секрет с фронтендом (INTERNAL_API_SECRET в frontend/.env.local).
INTERNAL_API_SECRET=

# ── Фото ──────────────────────────────────────────────────
# Папка с загруженными фото. Пусто — backend/uploads.
# UPLOADS_DIR=/var/lib/demalis/uploads

# ── Telegram (frontend/docs/SETUP.md, разделы 2а–2б) ───────
# Без них заявки сохраняются, но уведомления в Telegram не уходят.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_CHAT_ID=
# Только для локальных проверок с поддельным сервером Telegram. В работе не задавать.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081

# ── Ежедневные задачи ─────────────────────────────────────
# Запускаются сами в 12:00 по Алматы. Секрет — для ручного запуска:
# curl -X POST <адрес бэкенда>/cron/daily -H "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Второй экземпляр бэкенда не должен дублировать рассылки: CRON_ENABLED=false.
# CRON_ENABLED=false
